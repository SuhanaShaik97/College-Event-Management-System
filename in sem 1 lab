```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Event Portal</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #fff0f6;
            color: #333;
        }

        header {
            background: #d63384;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background: #ffe0ef;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: #a61e60;
            text-decoration: none;
            margin: 15px;
            font-weight: bold;
        }

        .welcome {
            text-align: center;
            padding: 25px;
        }

        .events {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 20px;
        }

        .card {
            background: white;
            width: 250px;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 10px #e9b8d0;
        }

        .card h3 {
            color: #d63384;
        }

        button {
            background: #d63384;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background: #a61e60;
        }

        footer {
            background: #d63384;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 25px;
        }
    </style>
</head>

<body>

    <header>
        <h1>College Event Portal</h1>
        <p>Discover, Participate and Celebrate!</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#events">Events</a>
        <a href="#about">About</a>
    </nav>

    <section class="welcome" id="home">
        <h2>Welcome to Our College</h2>
        <p>Explore exciting events and showcase your talents.</p>
    </section>

    <section class="events" id="events">

        <div class="card">
            <h3>Technical Fest</h3>
            <p>Date: 20 October 2026</p>
            <p>Participate in coding and technology competitions.</p>
            <button onclick="register('Technical Fest')">
                Register
            </button>
        </div>

        <div class="card">
            <h3>Cultural Fest</h3>
            <p>Date: 25 October 2026</p>
            <p>Enjoy music, dance and cultural activities.</p>
            <button onclick="register('Cultural Fest')">
                Register
            </button>
        </div>

        <div class="card">
            <h3>Sports Meet</h3>
            <p>Date: 30 October 2026</p>
            <p>Show your skills in exciting sports events.</p>
            <button onclick="register('Sports Meet')">
                Register
            </button>
        </div>

    </section>

    <section class="welcome" id="about">
        <h2>About Us</h2>
        <p>Our college organizes events to encourage creativity,
           teamwork and technical skills.</p>
    </section>

    <footer>
        <p>&copy; 2026 College Event Portal</p>
    </footer>

    <script>
        function register(eventName) {
            alert("You selected " + eventName + "!");
        }
    </script>

</body>
</html>
