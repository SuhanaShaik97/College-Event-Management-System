```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Event Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f2f5ff;
            color: #333;
        }

        header {
            background-color: #243b80;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background-color: #182858;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        section {
            background: white;
            margin: 20px auto;
            padding: 20px;
            max-width: 800px;
            border-radius: 10px;
        }

        h2 {
            color: #243b80;
        }

        .event {
            background: #eef1ff;
            padding: 15px;
            margin: 12px 0;
            border-radius: 8px;
        }

        input, select, textarea {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
            box-sizing: border-box;
        }

        button {
            background: #243b80;
            color: white;
            padding: 12px 20px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background: #405bb5;
        }

        footer {
            text-align: center;
            background: #182858;
            color: white;
            padding: 15px;
        }
    </style>
</head>

<body>

<header>
    <h1>College Event Management System</h1>
    <p>Discover, Participate and Celebrate!</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#events">Events</a>
    <a href="#register">Register</a>
</nav>

<section id="home">
    <h2>Welcome</h2>
    <p>
        Welcome to our College Event Management System.
        Explore college events and register to participate
        in exciting activities.
    </p>
</section>

<section id="events">
    <h2>Upcoming Events</h2>

    <div class="event">
        <h3>Technical Symposium</h3>
        <p>Date: 20 November 2026</p>
        <p>Venue: College Auditorium</p>
    </div>

    <div class="event">
        <h3>Cultural Fest</h3>
        <p>Date: 25 November 2026</p>
        <p>Venue: Main College Ground</p>
    </div>

    <div class="event">
        <h3>Sports Meet</h3>
        <p>Date: 30 November 2026</p>
        <p>Venue: College Playground</p>
    </div>
</section>

<section id="register">
    <h2>Event Registration</h2>

    <form onsubmit="registerEvent(event)">
        <label>Student Name:</label>
        <input type="text" id="studentName"
               placeholder="Enter your name" required>

        <label>Student Email:</label>
        <input type="email" id="studentEmail"
               placeholder="Enter your email" required>

        <label>Choose Event:</label>
        <select id="eventName" required>
            <option value="">Select an event</option>
            <option>Technical Symposium</option>
            <option>Cultural Fest</option>
            <option>Sports Meet</option>
        </select>

        <label>Department:</label>
        <input type="text" id="department"
               placeholder="Enter your department" required>

        <button type="submit">Register Now</button>
    </form>

    <p id="message"></p>
</section>

<footer>
    <p>&copy; 2026 College Event Management System</p>
</footer>

<script>
    function registerEvent(event) {
        event.preventDefault();

        const name = document.getElementById("studentName").value;
        const eventName = document.getElementById("eventName").value;

        document.getElementById("message").textContent =
            "Thank you, " + name +
            "! Your registration for " + eventName +
            " has been received.";

        document.querySelector("form").reset();
    }
</script>

</body>
</html>
```